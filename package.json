{
  "name": "rio-m3e-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @rio-m3e/playground dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release:pack": "pnpm build && node scripts/pack.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "test": "vitest --project unit --project browser",
    "test:visual": "vitest --project vrt",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.0",
    "vitest-browser-vue": "^3.1.0",
    "vue": "catalog:"
  },
  "packageManager": "pnpm@11.23.0"
}
